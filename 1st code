// Define pin connections
const int stepPin = 3; 
const int dirPin = 2; 

void setup() {
  // Set pin modes as outputs
  pinMode(stepPin, OUTPUT);
  pinMode(dirPin, OUTPUT);
  delay(2000);
  // Set rotation direction (HIGH for clockwise, LOW for counter-clockwise)
  digitalWrite(dirPin, HIGH);
}

void loop() {
  // Generate a continuous pulse train
  digitalWrite(stepPin, HIGH);
  delayMicroseconds(1); // Decrease this number to make the motor spin FASTER
  digitalWrite(stepPin, LOW);
  delayMicroseconds(1000); // Increase this number to make the motor spin SLOWER
}
